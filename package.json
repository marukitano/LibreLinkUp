{
  "name": "open-libre-link-up",
  "author": "Marukitano",
  "version": "1.3.2",
  "description": "Displays LibreLinkUp glucose data, trend, delta, age, alerts, and a rolling history chart on Pebble Time 2.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/marukitano/OpenLibreLinkUp"
  },
  "keywords": [
    "pebble-app",
    "pebble-time-2",
    "librelinkup",
    "cgm"
  ],
  "scripts": {
    "build": "pebble clean && pebble build",
    "sideload": "pebble clean && pebble build && pebble install --cloudpebble --logs",
    "emulator": "pebble wipe && python3 scripts/inject-emu-settings.py && pebble build && pebble install --emulator emery --logs"
  },
  "dependencies": {
    "pebble-clay": "^1.0.4"
  },
  "pebble": {
    "sdkVersion": "3",
    "targetPlatforms": [
      "emery"
    ],
    "enableMultiJS": true,
    "capabilities": [
      "configurable"
    ],
    "projectType": "native",
    "displayName": "OpenLibreLinkUp",
    "uuid": "d6e24c1e-c8b5-4b1e-8c85-94b5b0264290",
    "watchapp": {
      "watchface": true,
      "hiddenApp": false,
      "onlyShownOnCommunication": false
    },
    "messageKeys": {
      "cgm_value": 0,
      "cgm_delta": 1,
      "cgm_trend": 2,
      "cgm_time_ago": 3,
      "cgm_history": 4,
      "cgm_alert": 5,
      "request_data": 6,
      "low_threshold": 7,
      "high_threshold": 8,
      "needs_setup": 9,
      "reversed": 10,
      "sync_error": 11,
      "good_color": 13,
      "warning_color": 14,
      "alarm_color": 15,
      "poll_interval": 16,
      "quick_view": 17,
      "low_alarm_threshold": 18,
      "high_alarm_threshold": 19,
      "cgm_unit": 20
    },
    "resources": {
      "media": []
    }
  }
}
